# Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Settings > API Keys > Publishable key. Finisce nel browser: e' previsto,
# a proteggere i dati e' la RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Settings > API Keys > Secret key. Serve SOLO per creare ed eliminare utenti
# da /admin/users. Bypassa la RLS: niente prefisso NEXT_PUBLIC_, mai in un
# commit, mai nel browser. Se la ometti l'app funziona lo stesso, ma gli
# accessi si possono solo approvare, non creare.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
